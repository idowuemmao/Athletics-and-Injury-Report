	partition DimCalender = calculated
		mode: import
		source =
				
				var mindate = MIN('FactInjuries'[InjuryDate])
				var maxdate = MAX(FactInjuries[InjuryDate])
				var BaseCalender = CALENDAR(mindate, maxdate)
				RETURN
				ADDCOLUMNS(
				    BaseCalender,
				    "Year", YEAR([Date]),
				    "Quarter",QUARTER([Date]),
				    "Month No",MONTH([Date]),
				    "Week Num", WEEKNUM([Date]),
				    "Day", DAY([Date]),
				    "Month Name", FORMAT([Date], "MMMM"),
				    "Month Short", FORMAT([Date], "MMM"),
				    "DayName", FORMAT([Date], "dddd"),
				    "Qtr Number", "Q" & QUARTER([Date]),
				    "Year Month", FORMAT([Date], "YYYY MMMM"),
				    "Year Quarter", FORMAT([Date], "YYYY") & "Q" & FORMAT([Date], "Q"),
				    "Day Type", IF(WEEKDAY([Date], 2) > 5, "Weekend", "Weekday"),
				    "Weekending", [Date] + (7 - WEEKDAY([Date])),
				    "Start of Month", DATE(YEAR([Date]), MONTH([Date]), 1),
				    "Start of Year", DATE(YEAR([Date]), 1, 1)
				)

	annotation PBI_Id = a7f176b37e0342e5bdb9366876c92b13

