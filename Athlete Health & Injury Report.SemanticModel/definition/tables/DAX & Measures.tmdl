table 'DAX & Measures'
	lineageTag: dcaf97b6-9344-4e09-9ccd-1e0e19040d64

	measure 'Total Injuries' = COUNT(FactInjuries[InjuryID])
		formatString: #,0.00
		displayFolder: Aggregate Measures
		lineageTag: d437d8d0-e968-4234-895a-acfd5cd8a301

	measure 'Avg Recovery(Days)' = AVERAGE(FactInjuries[DaysToRecovery])
		formatString: #,0
		displayFolder: Average Measures
		lineageTag: 1d95691c-649a-495c-a9c1-53d4f241a559

		annotation PBI_FormatHint = {"isDecimal":true}

	measure 'Severe Injury' =
			
			CALCULATE([Total Injuries], DimInjuryType[Severity] = "Severe")
		formatString: #,0.00
		displayFolder: Aggregate Measures
		lineageTag: a53372f2-4a8c-4c40-93a8-303732ada02e

	measure '% Severe Injuries' = DIVIDE([Severe Injury], [Total Injuries],0)
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: % of Total
		lineageTag: 78d78ec1-3601-4894-a841-ec242466671b

	measure 'Cost per Injury' = AVERAGE(FactInjuries[CostOfTreatmentEuros])
		formatString: #,0.00
		displayFolder: Aggregate Measures
		lineageTag: 9564d186-3bd2-4b9c-b0da-d820df2a2284

	measure 'Total Injuries MoM%' =
			
			IF(
				ISFILTERED('DimCalender'[Date]),
				ERROR("Time intelligence quick measures can only be grouped or filtered by the Power BI-provided date hierarchy or primary date column."),
				VAR __PREV_MONTH = CALCULATE([Total Injuries], DATEADD('DimCalender'[Date].[Date], -1, MONTH))
				RETURN
					DIVIDE([Total Injuries] - __PREV_MONTH, __PREV_MONTH)
			)
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: Time Intelligence
		lineageTag: ea587e8b-c67e-4863-8a57-45e5b9a9a83f

		extendedProperty MeasureTemplate =
				{
				  "version": 0,
				  "daxTemplateName": "MonthOverMonth"
				}

		changedProperty = FormatString

	measure 'Median Days to Recovery' = MEDIAN(FactInjuries[DaysToRecovery])
		formatString: 0.00
		displayFolder: Aggregate Measures
		lineageTag: 9664808f-ba10-4783-a0d7-3cf78b0e8e9e

	measure 'Total Minutes Played' = SUM(FactInjuries[MinutesPlayedLast30Days])
		formatString: #,0.00
		displayFolder: Aggregate Measures
		lineageTag: 56348aa0-eed5-4a9a-a841-b7ac688e229c

	measure 'Total Injuries QoQ%' =
			
			IF(
				ISFILTERED('DimCalender'[Date]),
				ERROR("Time intelligence quick measures can only be grouped or filtered by the Power BI-provided date hierarchy or primary date column."),
				VAR __PREV_QUARTER =
					CALCULATE(
						[Total Injuries],
						DATEADD('DimCalender'[Date].[Date], -1, QUARTER)
					)
				RETURN
					DIVIDE([Total Injuries] - __PREV_QUARTER, __PREV_QUARTER)
			)
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: Time Intelligence
		lineageTag: 3d393b77-3736-44a6-8ea1-63bdea0f3888

		extendedProperty MeasureTemplate =
				{
				  "version": 0,
				  "daxTemplateName": "QuarterOverQuarter"
				}

		changedProperty = FormatString

	measure 'Fully Recovered' =
			
			CALCULATE([Total Injuries], DimTreatment[Outcome] = "Fully Recovered")
		formatString: #,0.00
		displayFolder: Aggregate Measures
		lineageTag: 213b0199-f17e-4243-857e-40b01e539775

	measure '% fully recovered' =
			
			DIVIDE([Fully Recovered], [Total Injuries],0)
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: % of Total
		lineageTag: 934fd6c3-9324-459f-871a-a9b46c8e9a60

	measure '% Reoccuring' =
			
			VAR numberOfReoccuring = CALCULATE([Total Injuries], DimInjuryType[IsRecurrentInjury] = "Yes")
			RETURN DIVIDE(numberOfReoccuring , [Total Injuries], 0)
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: % of Total
		lineageTag: 2f097217-362c-49fe-8993-642efe7d4ce7

	measure 'Treatment Cost' = SUM(FactInjuries[CostOfTreatmentEuros])
		formatString: "€"\ #,0.00;-"€"\ #,0.00;"€"\ #,0.00
		displayFolder: Aggregate Measures
		lineageTag: 1158df20-834f-4646-a176-09a2d2c517fc

	measure 'Date Range' =
			
			VAR mindate = FORMAT(MIN(DimCalender[Date]),"dd mmm yy")
			var maxdate = FORMAT(MAX(DimCalender[Date]), "dd mmm yy")
			RETURN "Showing Overview and Outcome distribution from "& mindate & " - " & maxdate
		displayFolder: Text Measures
		lineageTag: 1f911759-906b-40f2-955f-48664119ec4b

	measure 'High Risk Players' =
			
			CALCULATE(DISTINCTCOUNT(FactInjuries[PlayerDimKey]), FactInjuries[Player Risk] = "High Risk 90+")
		formatString: #,0.00
		displayFolder: Aggregate Measures
		lineageTag: dfe36a36-8968-4135-aef6-e3a753bfc024

	measure TopInjuryType = ```
			
			VAR TopPlayer =
			    TOPN(
			        1,
			        SUMMARIZE(
			            FactInjuries,
			            DimInjuryType[InjuryType],
			            "InjuryCount", COUNT(FactInjuries[InjuryID])
			        ),
			        [InjuryCount], DESC
			    )
			RETURN
			    CONCATENATEX(TopPlayer,DimInjuryType[InjuryType], ", ")
			
			```
		displayFolder: Text Measures
		lineageTag: 13670136-a206-42cd-9bf1-1603b4302910

	measure TopInjuryCause = ```
			
			VAR InjuryCause =
			    TOPN(
			        1,
			        SUMMARIZE(
			            FactInjuries,
			            DimInjuryType[InjuryCause],
			            "InjuryCount", COUNT(FactInjuries[InjuryID])
			        ),
			        [InjuryCount], DESC
			    )
			RETURN
			    CONCATENATEX(InjuryCause, DimInjuryType[InjuryCause], ", ")
			
			```
		displayFolder: Text Measures
		lineageTag: b23f9513-3b08-4269-8a8d-9ff92f013c64

	measure MostEffectiveTreatment = ```
			
			VAR TopTreatment =
			    TOPN(
			        1,
			        SUMMARIZE(
			            FactInjuries,
			            DimTreatment[TreatmentMethod],
			            "RecoveredCount",
			                CALCULATE(
			                    COUNTROWS(FactInjuries),
			                    DimTreatment[Outcome] = "Fully Recovered"
			                )
			        ),
			        [RecoveredCount], DESC
			    )
			RETURN
			    CONCATENATEX(TopTreatment, DimTreatment[TreatmentMethod], ", ")
			
			```
		displayFolder: Text Measures
		lineageTag: 85570ede-640d-4113-b613-99f42d9c48a1

	measure 'Hand Injury' =
			
			VAR bodypart = "Hand"
			VAR no = CALCULATE([Total Injuries], DimInjuryType[BodyPart] = bodypart)
			VAR perchand = DIVIDE(no, [Total Injuries],0)
			VAR treatment =
			    TOPN(
			        1,
			        SUMMARIZE(
			            FactInjuries,
			            DimTreatment[TreatmentMethod],
			            "RecoveredCount",
			                CALCULATE(
			                    COUNTROWS(FactInjuries),
			                    DimTreatment[Outcome] = "Fully Recovered",
			                    DimInjuryType[BodyPart] = bodypart
			                )
			        ),
			        [RecoveredCount], DESC
			    )
			VAR treatmentName = CONCATENATEX(treatment, DimTreatment[TreatmentMethod], ", ")
			VAR TopSport =
			    TOPN(
			        1,
			        SUMMARIZE(
			            FactInjuries,
			            DimClub[Sport],
			            "InjuryCount",
			                CALCULATE(
			                    COUNTROWS(FactInjuries),
			                    DimInjuryType[BodyPart] = bodypart
			                )
			        ),
			        [InjuryCount], DESC
			    )
			VAR sportname = CONCATENATEX(TopSport, DimClub[Sport], ", ")
			
			RETURN bodypart & ": "& no &"nrs | " & FORMAT(perchand,"0.00%") & " | " & treatmentName & " | " & sportname
		displayFolder: Body Part
		lineageTag: ef58f4cd-fd71-45a1-8a10-eb50d9df5150

